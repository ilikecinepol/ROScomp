#VRML_SIM R2025a utf8

EXTERNPROTO "../protos/Go2.proto"

WorldInfo {
  title "Go2 camera and lidar test"
  basicTimeStep 16
  coordinateSystem "ENU"
}

Viewpoint {
  orientation 0.57735 0.57735 0.57735 2.094395
  position 2.5 -3.5 1.8
}
Background { skyColor [ 0.14 0.15 0.17 ] }
DirectionalLight { direction -0.3 -0.4 -1 intensity 2 ambientIntensity 0.6 }

Solid {
  name "sensor test floor"
  translation 0 0 -0.05
  children [
    Shape {
      appearance PBRAppearance { baseColor 0.48 0.47 0.43 roughness 0.9 }
      geometry Box { size 8 6 0.1 }
    }
  ]
  boundingObject Box { size 8 6 0.1 }
  locked TRUE
}

Solid {
  name "camera and lidar target"
  translation 1.5 0 0.5
  children [
    Shape {
      appearance PBRAppearance { baseColor 0.9 0.2 0.1 roughness 0.7 }
      geometry Box { size 0.4 1.0 1.0 }
    }
  ]
  boundingObject Box { size 0.4 1.0 1.0 }
  locked TRUE
}

DEF GO2 Go2 {
  translation 0 0 0.34
  supervisor TRUE
  controller "go2_virtual_sport"
  controllerArgs [ "--udp-port=15001" "--save-camera" ]
  name "Go2 sensor test"
}
